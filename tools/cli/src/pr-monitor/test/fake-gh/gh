#!/usr/bin/env bash
# Fake `gh` for gh.test.ts's fetchReviews/fetchUnresolvedThreads failure-signal tests. Succeeds for
# `pr view` and `pr checks`, and for both GraphQL queries unless FAIL_REVIEWS or FAIL_THREADS (from
# the inherited environment) says otherwise — letting each test fail exactly one fetch while the
# rest of fetchPrState proceeds normally. CHECKS_JSON, when set, is the `pr checks` payload.
# NO_CHECKS=1 makes `pr checks` fail as the real gh does on a PR with no CI: exit 1, nothing on
# stdout, "no checks reported on the '<branch>' branch" on stderr. A GH_SLEEP_SECS replaces
# the process with a sleep of that length, standing in for a hung gh.
set -u

if [ -n "${GH_SLEEP_SECS:-}" ]; then
  exec sleep "$GH_SLEEP_SECS"
fi

if [ "$1" = "pr" ] && [ "$2" = "view" ]; then
  echo '{"state":"open","isDraft":false,"mergeable":"UNKNOWN","mergeStateStatus":"UNKNOWN","headRefOid":"abc123","comments":'"${COMMENTS_JSON:-[]}"'}'
  exit 0
fi

# RUN_SLEEP_SECS stands in for a hung workflow-run status read.
if [ "$1" = "api" ] && [ "${2#repos/}" != "$2" ]; then
  if [ -n "${RUN_SLEEP_SECS:-}" ]; then
    exec sleep "$RUN_SLEEP_SECS"
  fi
  echo '{"status":"completed","attempt":1}'
  exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "checks" ]; then
  if [ "${NO_CHECKS:-}" = "1" ]; then
    echo "no checks reported on the 'fake-branch' branch" >&2
    exit 1
  fi
  echo "${CHECKS_JSON:-[]}"
  exit 0
fi

if [ "$1" = "api" ] && [ "$2" = "graphql" ]; then
  query=""
  for arg in "$@"; do
    case "$arg" in
      query=*) query="$arg" ;;
    esac
  done
  case "$query" in
    *"reviews(first:"*)
      if [ "${FAIL_REVIEWS:-}" = "1" ]; then
        echo "fake gh: reviews query failed" >&2
        exit 1
      fi
      echo '{"data":{"repository":{"pullRequest":{"reviews":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[]}}}}}'
      exit 0
      ;;
    *"reviewThreads(first:"*)
      if [ "${FAIL_THREADS:-}" = "1" ]; then
        echo "fake gh: reviewThreads query failed" >&2
        exit 1
      fi
      echo '{"data":{"repository":{"pullRequest":{"reviewThreads":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[]}}}}}'
      exit 0
      ;;
    *"nodes(ids:"*)
      # NODE_LOG, when set, gets one line per node read.
      if [ -n "${NODE_LOG:-}" ]; then
        echo "node read" >>"$NODE_LOG"
      fi
      if [ -n "${NODE_SLEEP_SECS:-}" ]; then
        exec sleep "$NODE_SLEEP_SECS"
      fi
      # The real gh refuses a read naming more than 100 ids.
      id_count=0
      for arg in "$@"; do
        case "$arg" in
          "ids[]="*) id_count=$((id_count + 1)) ;;
        esac
      done
      if [ "$id_count" -gt 100 ]; then
        echo "gh: You may not provide more than 100 node ids; you provided $id_count." >&2
        exit 1
      fi
      # NODE_DIR, when set, holds one `<comment id>.json` node per comment; a read naming an id with
      # no file there fails. Without it every id reads as the same stated refusal.
      nodes=""
      for arg in "$@"; do
        case "$arg" in
          "ids[]="*) node_id="${arg#*=}" ;;
          *) continue ;;
        esac
        if [ -z "${NODE_DIR:-}" ]; then
          node='{"id":"'"$node_id"'","body":"Review rate limited. Next review available in 7 minutes","updatedAt":"2026-01-01T00:00:00Z"}'
        elif [ -f "$NODE_DIR/$node_id.json" ]; then
          node="$(cat "$NODE_DIR/$node_id.json")"
        else
          echo "fake gh: no node payload for $node_id" >&2
          exit 1
        fi
        nodes="${nodes:+$nodes,}$node"
      done
      echo '{"data":{"nodes":['"$nodes"']}}'
      exit 0
      ;;
    *)
      echo "fake gh: unrecognized graphql query" >&2
      exit 1
      ;;
  esac
fi

echo "fake gh: unrecognized args: $*" >&2
exit 1
