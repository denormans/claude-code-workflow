#!/usr/bin/env bash
# test-lock — agents run by this user take turns running tests (FLOW-420).
#
#   test-lock [--beat <session id>] -- <command> [args...]
#   test-lock status
#
# One kernel lock per user, in one fixed directory, serializes every test run by that user's agents
# on the machine, whatever project it is in. The kernel drops the lock when the process holding it
# dies, so a killed run never leaves the machine blocked and nothing here has to detect a stale
# lock. There is no wait limit: some suites run an hour or more on their own.
#
# Each state change is printed to stderr the moment it happens, so the agent knows it is waiting and
# on whom, and does not retry. While waiting and while running it beats the board session: the
# session's own waker beats only after tool activity, and an agent waiting on a long background run
# makes none, so without this the board would mark it hung. A teammate's beat reaches its lead's node
# too (`dashboard session heartbeat` finds the lead that spawned it), so `--beat` is only for
# beating a session other than the caller's own.
#
# A run that has held the lock for TEST_LOCK_LONG_SECONDS (an hour by default) is flagged once on
# stderr, because every other agent's tests wait behind it. When CLAUDE_CODE_SESSION_ID is set it
# also tries a board note, which `dashboard item add` puts on the caller's own node, a teammate's
# lead's node, or a node it opens for a caller that has neither; a note it refuses is reported on
# stderr. The run is never stopped.
#
# Runs on macOS's /bin/bash 3.2: no {fd} redirections, no ${var@Q}.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOCK_DIR="${TEST_LOCK_ROOT:-/tmp}/claude-agent-tests-$(id -u)"
LOCK_FILE="${LOCK_DIR}/lock"
HOLDER_FILE="${LOCK_DIR}/holder"
BEAT_SECONDS="${TEST_LOCK_BEAT_SECONDS-300}"
LONG_SECONDS="${TEST_LOCK_LONG_SECONDS-3600}"
LONG_POLL_SECONDS=2
DASHBOARD="${TEST_LOCK_DASHBOARD:-${SCRIPT_DIR}/dashboard}"
CHILD_PID=""
BEAT_PID=""
LONG_PID=""

main() {
    case "${1:-}" in
        status) print_status ;;
        --beat | --) run_locked "$@" ;;
        *) usage ;;
    esac
}

run_locked() {
    local beat_session="${CLAUDE_CODE_SESSION_ID:-}" locker waited_from ran_from rc holding=""
    if [[ "$1" == "--beat" ]]; then
        [[ -n "${2:-}" ]] || usage
        beat_session="$2"
        shift 2
    fi
    [[ "${1:-}" == "--" && $# -ge 2 ]] || usage
    shift
    require_seconds TEST_LOCK_BEAT_SECONDS "$BEAT_SECONDS"
    require_seconds TEST_LOCK_LONG_SECONDS "$LONG_SECONDS"

    # A run whose own tests call test-lock would otherwise wait on itself forever.
    if [[ -n "${TEST_LOCK_HELD:-}" ]]; then
        exec "$@"
    fi
    export TEST_LOCK_HELD=1

    if ! locker="$(find_locker)"; then
        say "no flock or lockf on this machine — running unlocked"
        exec "$@"
    fi
    # fd 9 holds the lock for as long as this process lives. A sandbox that cannot write the lock
    # file must not cost the agent its test run.
    if ! lock_dir_is_ours || ! { exec 9>>"$LOCK_FILE"; } 2>/dev/null; then
        say "cannot open ${LOCK_FILE} — running unlocked"
        exec "$@"
    fi

    start_beat "$beat_session"
    trap stop_helpers EXIT

    waited_from="$(date +%s)"
    if lock_now "$locker"; then
        say "lock free — running"
        record_holder "$*"
        holding=1
    else
        say "waiting — held by $(holder_description)"
        if lock_wait "$locker"; then
            say "acquired after $(duration_since "$waited_from") — running"
            record_holder "$*"
            holding=1
        else
            say "could not take the lock — running unlocked"
        fi
    fi

    ran_from="$(date +%s)"
    if [[ -n "$holding" ]]; then
        start_long_watch "$*" "$ran_from"
    fi
    run_command "$@"
    rc=$?
    exec 9>&-
    say "released after $(duration_since "$ran_from"), exit ${rc}"
    exit "$rc"
}

print_status() {
    local locker
    if ! locker="$(find_locker)" || ! lock_dir_is_ours || ! { exec 9>>"$LOCK_FILE"; } 2>/dev/null; then
        echo "unknown — cannot open ${LOCK_FILE}"
        exit 0
    fi
    if lock_now "$locker"; then
        echo "free"
    else
        echo "held by $(holder_description)$(held_for)"
    fi
    exit 0
}

# The command does not inherit fd 9: a worker that outlives the run must not keep the lock held
# after test-lock is gone. It stays in test-lock's process group, so a kill sent to the group
# reaches it directly; a signal sent only to test-lock is forwarded to it. A background job starts
# with SIGINT and SIGQUIT ignored; perl restores them before exec, on bash 3.2 and 5 alike, and
# exits 127 or 126 as the shell does when the command cannot be run.
run_command() {
    local rc
    if command -v perl >/dev/null 2>&1; then
        perl -e '$SIG{INT}=$SIG{QUIT}="DEFAULT"; exec {$ARGV[0]} @ARGV; print STDERR "test-lock: cannot run $ARGV[0]: $!\n"; exit($!{ENOENT} ? 127 : 126)' "$@" 9>&- <&0 &
    else
        "$@" 9>&- <&0 &
    fi
    CHILD_PID=$!
    trap 'forward_signal TERM' TERM
    trap 'forward_signal INT' INT
    trap 'forward_signal HUP' HUP
    while :; do
        wait "$CHILD_PID"
        rc=$?
        # A trapped signal interrupts wait while the command is still running.
        kill -0 "$CHILD_PID" 2>/dev/null || break
    done
    return "$rc"
}

forward_signal() {
    kill -"$1" "$CHILD_PID" 2>/dev/null
}

start_beat() {
    [[ -n "$1" ]] || return 0
    beat_loop "$1" "$$" 9>&- &
    BEAT_PID=$!
}

# Beats until test-lock stops it, or until test-lock is gone: a SIGKILLed test-lock runs no EXIT
# trap, and an orphaned beat would keep a finished session looking alive.
beat_loop() {
    local session="$1" parent="$2" sleep_pid=""
    trap '[[ -n "$sleep_pid" ]] && kill "$sleep_pid" 2>/dev/null; exit 0' TERM
    while kill -0 "$parent" 2>/dev/null; do
        sleep "$BEAT_SECONDS" &
        sleep_pid=$!
        wait "$sleep_pid"
        kill -0 "$parent" 2>/dev/null || break
        "$DASHBOARD" session heartbeat --session "$session" >/dev/null 2>&1
    done
}

stop_helpers() {
    [[ -n "$BEAT_PID" ]] && kill "$BEAT_PID" 2>/dev/null
    [[ -n "$LONG_PID" ]] && kill "$LONG_PID" 2>/dev/null
    return 0
}

start_long_watch() {
    long_watch "$1" "$$" "$2" 9>&- &
    LONG_PID=$!
}

# Flags the run once it has held the lock for LONG_SECONDS since ran_from, then exits. It checks
# every LONG_POLL_SECONDS that test-lock is still alive, so a SIGKILLed test-lock's watcher exits
# within one interval, unless another process takes that pid within the same interval. The flag is
# a stderr line. The board note is tried only when CLAUDE_CODE_SESSION_ID is set, carries the
# command cut to 400 characters and the directory cut to 200, and when `dashboard item add` exits
# non-zero (no board installed, a lead lookup that failed, a refused note) that is said on stderr
# and no note is posted.
long_watch() {
    local command="$1" parent="$2" ran_from="$3" sleep_pid="" now left held shown dir note
    trap '[[ -n "$sleep_pid" ]] && kill "$sleep_pid" 2>/dev/null; exit 0' TERM

    while :; do
        kill -0 "$parent" 2>/dev/null || exit 0
        now="$(date +%s)"
        left=$((ran_from + LONG_SECONDS - now))
        ((left <= 0)) && break
        sleep "$((left < LONG_POLL_SECONDS ? left : LONG_POLL_SECONDS))" &
        sleep_pid=$!
        wait "$sleep_pid"
    done

    held="$(format_duration "$((now - ran_from))")"
    say "still running after ${held} — ${command}"
    [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]] || exit 0

    shown="$(truncate_text "$command" 400)"
    dir="$(truncate_text "$PWD" 200)"
    note="$(printf 'One test run has held the test lock for %s, so every other agent'"'"'s tests are waiting behind it.\n\n`%s` in `%s`' "$held" "$shown" "$dir")"
    if ! "$DASHBOARD" item add --type info --prompt "$note" >/dev/null; then
        say "could not post the board note"
    fi
    exit 0
}

truncate_text() {
    if ((${#1} > $2)); then
        printf '%s...' "${1:0:$2}"
    else
        printf '%s' "$1"
    fi
}

# The directory is created private to this user; it must be a real directory this user owns, or
# another user could point the lock file somewhere else.
lock_dir_is_ours() {
    if [[ ! -e "$LOCK_DIR" && ! -L "$LOCK_DIR" ]]; then
        mkdir -m 700 "$LOCK_DIR" 2>/dev/null
    fi
    [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" && -O "$LOCK_DIR" ]]
}

find_locker() {
    if command -v flock >/dev/null 2>&1; then
        echo flock
    elif [[ -x /usr/bin/lockf ]]; then
        echo lockf
    else
        return 1
    fi
}

lock_now() {
    case "$1" in
        flock) flock -n 9 ;;
        lockf) /usr/bin/lockf -s -t 0 9 ;;
    esac
}

lock_wait() {
    case "$1" in
        flock) flock 9 ;;
        lockf) lockf_wait ;;
    esac
}

# macOS's lockf waits on a descriptor by calling flock() in a loop, a full core for the whole wait, so
# python3 makes one blocking flock() on fd 9 instead. It is the same lock lockf takes, and fd 9 keeps
# it once python3 exits. A python3 that is missing or cannot run falls back to lockf's wait, which
# still works, only wastefully.
lockf_wait() {
    python3 -I -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)' 2>/dev/null || /usr/bin/lockf -s 9
}

# Display only — the kernel lock is the sole authority on who holds it.
record_holder() {
    { printf '%s running `%s` (pid %s) since %s\n' "$PWD" "$1" "$$" "$(date '+%Y-%m-%d %H:%M:%S')" \
        > "$HOLDER_FILE"; } 2>/dev/null || true
}

holder_description() {
    local line
    line="$(cat "$HOLDER_FILE" 2>/dev/null)"
    echo "${line:-another test run}"
}

# The record's trailing "since YYYY-mm-dd HH:MM:SS" is the start time, the same record every
# test-lock version reads. A record without it, one neither BSD nor GNU date can parse, or one whose
# start is later than now (a holder in a zone ahead of the caller's, or a clock stepped back) has no
# figure.
held_for() {
    local line since epoch pattern='since ([0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})$'
    line="$(cat "$HOLDER_FILE" 2>/dev/null)"
    [[ "$line" =~ $pattern ]] || return 0
    since="${BASH_REMATCH[1]}"
    epoch="$(date -j -f '%Y-%m-%d %H:%M:%S' "$since" +%s 2>/dev/null || date -d "$since" +%s 2>/dev/null)"
    [[ "$epoch" =~ ^[0-9]+$ ]] || return 0
    ((epoch <= $(date +%s))) || return 0
    printf ' — held for %s' "$(duration_since "$epoch")"
    return 0
}

duration_since() {
    format_duration "$(($(date +%s) - $1))"
}

format_duration() {
    local s=$1
    if ((s >= 3600)); then
        printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
    elif ((s >= 60)); then
        printf '%dm%02ds' $((s / 60)) $((s % 60))
    else
        printf '%ds' "$s"
    fi
}

say() {
    printf 'test-lock: %s\n' "$*" >&2
}

require_seconds() {
    if [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
        say "$1 must be a positive whole number of seconds, got '$2'"
        exit 2
    fi
}

usage() {
    cat >&2 <<'EOF'
usage: test-lock [--beat <session id>] -- <command> [args...]
       test-lock status
EOF
    exit 2
}

main "$@"
