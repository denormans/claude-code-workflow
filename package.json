{
  "name": "claude-workflow",
  "version": "1.104.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:hooks",
    "test:hooks": "hooks/run-tests.sh",
    "lint": "eslint . && node --experimental-transform-types tools/cli/src/main.ts check-refs --root .",
    "publish-check": "node --experimental-transform-types tools/cli/src/main.ts publish-check",
    "publish-snapshot": "node --experimental-transform-types tools/cli/src/main.ts publish-snapshot",
    "snapshot-release-notes": "node --experimental-transform-types tools/cli/src/main.ts snapshot-release-notes",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "pnpm@12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5"
}
