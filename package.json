{
  "name": "claude-workflow",
  "version": "1.109.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:hooks",
    "test:hooks": "hooks/run-tests.sh",
    "lint": "eslint . && node --experimental-transform-types tools/cli/src/main.ts check-refs --root .",
    "publish-check": "node --experimental-transform-types tools/cli/src/main.ts publish-check",
    "publish-snapshot": "node --experimental-transform-types tools/cli/src/main.ts publish-snapshot",
    "snapshot-release-notes": "node --experimental-transform-types tools/cli/src/main.ts snapshot-release-notes",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
