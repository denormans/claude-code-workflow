{
  "name": "claude-workflow",
  "version": "1.104.2",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:hooks",
    "test:hooks": "hooks/run-tests.sh",
    "lint": "eslint . && node --experimental-transform-types tools/cli/src/main.ts check-refs --root .",
    "publish-check": "node --experimental-transform-types tools/cli/src/main.ts publish-check",
    "publish-snapshot": "node --experimental-transform-types tools/cli/src/main.ts publish-snapshot",
    "snapshot-release-notes": "node --experimental-transform-types tools/cli/src/main.ts snapshot-release-notes",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
